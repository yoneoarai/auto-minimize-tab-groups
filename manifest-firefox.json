{
  "manifest_version": 3,
  "name": "Tabbi - Tab Group Manager",
  "author": "yoneoarai@gmail.com",
  "description": "Automatically organize tabs into groups with URL rules and customize auto-minimize behavior.",
  "version": "1.0.0",
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "tabGroups",
    "storage"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tabbi - Tab Group Manager"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "auto-minimize-tab-groups@yoneoarai.com",
      "strict_min_version": "138.0"
    }
  },
  "homepage_url": "https://github.com/yoneoarai/auto-minimize-tab-groups"
}
