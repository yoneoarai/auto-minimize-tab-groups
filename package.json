{
  "name": "auto-minimize-tab-groups",
  "version": "1.1.0",
  "description": "Automatically organize tabs into groups with URL rules and customize auto-minimize behavior.",
  "scripts": {
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "webpack --mode production --env browser=chrome",
    "build:firefox": "webpack --mode production --env browser=firefox",
    "build:dev": "npm run build:dev:chrome && npm run build:dev:firefox",
    "build:dev:chrome": "webpack --mode development --env browser=chrome",
    "build:dev:firefox": "webpack --mode development --env browser=firefox",
    "watch:chrome": "webpack --mode development --env browser=chrome --watch",
    "watch:firefox": "webpack --mode development --env browser=firefox --watch",
    "package": "npm run build && node scripts/package.js",
    "package:chrome": "npm run build:chrome && node scripts/package.js chrome",
    "package:firefox": "npm run build:firefox && node scripts/package.js firefox",
    "clean": "rm -rf dist *.zip",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "keywords": [
    "chrome",
    "firefox",
    "extension",
    "browser-extension",
    "cross-browser",
    "tab-groups"
  ],
  "author": "Yoneo Arai",
  "license": "ISC",
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.3.2",
    "copy-webpack-plugin": "^12.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.2",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4"
  }
}
